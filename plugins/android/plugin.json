{
  "id": "android",
  "name": "Android",
  "version": "0.3.0",
  "api": 0,
  "description": "同一 Wi-Fi 下无线投屏华为/安卓手机，并与手机双向传文件。首次用数据线一键开通，之后无需插线。",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "entry": "bin/android-plugin.exe",
  "capabilities": [
    "discover",
    "session",
    "window",
    "diagnose"
  ],
  "settings": {
    "type": "object",
    "properties": {
      "maxSize": {
        "type": "integer",
        "default": 1080,
        "minimum": 480,
        "maximum": 2160,
        "title": "最大分辨率"
      },
      "maxFps": {
        "type": "integer",
        "default": 60,
        "minimum": 15,
        "maximum": 120,
        "title": "帧率上限"
      },
      "audio": {
        "type": "boolean",
        "default": true,
        "title": "转发音频"
      },
      "stayAwake": {
        "type": "boolean",
        "default": true,
        "title": "投屏时保持亮屏"
      },
      "lockOrientation": {
        "type": "boolean",
        "default": true,
        "title": "锁定竖屏"
      },
      "orientation": {
        "type": "string",
        "default": "0",
        "title": "画面方向"
      },
      "lockPosition": {
        "type": "boolean",
        "default": false,
        "title": "固定窗口位置"
      },
      "brightness": {
        "type": "number",
        "default": 0,
        "title": "手机亮度（0 = 不修改）"
      }
    }
  },
  "panel": [
    {
      "type": "text",
      "text": "改动会立即应用到当前画面；分辨率/帧率变化会重启画面约 1 秒。"
    },
    {
      "type": "switch",
      "key": "lockOrientation",
      "label": "锁定竖屏（手机转动画面不跟着转）"
    },
    {
      "type": "switch",
      "key": "lockPosition",
      "label": "固定窗口位置（拖不动）"
    },
    {
      "type": "switch",
      "key": "audio",
      "label": "转发音频（Android 13+；HarmonyOS 4 不支持）"
    },
    {
      "type": "switch",
      "key": "stayAwake",
      "label": "投屏时保持手机亮屏"
    },
    {
      "type": "slider",
      "key": "brightness",
      "label": "手机亮度（0 = 不修改）",
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "slider",
      "key": "maxSize",
      "label": "最大分辨率",
      "min": 480,
      "max": 2160,
      "step": 1
    },
    {
      "type": "slider",
      "key": "maxFps",
      "label": "帧率上限",
      "min": 15,
      "max": 120,
      "step": 1
    }
  ]
}
