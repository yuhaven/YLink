{
  "id": "airplay",
  "name": "AirPlay",
  "version": "0.3.0",
  "api": 0,
  "description": "接收 iPad / iPhone 的屏幕镜像，基于 uxplay-windows",
  "platforms": ["windows"],
  "entry": "bin/airplay-plugin.exe",
  "capabilities": ["discover", "session", "window", "diagnose"],
  "settings": {
    "type": "object",
    "properties": {
      "receiverName": {
        "type": "string",
        "default": "CastPane",
        "title": "接收端名称"
      },
      "renderer": {
        "type": "string",
        "enum": ["auto", "d3d11", "d3d12"],
        "default": "auto",
        "title": "渲染器"
      },
      "fullscreen": {
        "type": "boolean",
        "default": false,
        "title": "画面全屏"
      },
      "lowLatency": {
        "type": "boolean",
        "default": true,
        "title": "低延迟模式"
      }
    }
  },
  "panel": [
    { "type": "text", "text": "iPad 控制中心 → 屏幕镜像 → 选择接收端名称。首次使用需要 Bonjour 发现服务。" },
    { "type": "switch", "key": "lowLatency", "label": "低延迟模式（60fps）" },
    { "type": "switch", "key": "fullscreen", "label": "画面全屏" },
    { "type": "select", "key": "renderer", "label": "渲染器" },
    { "type": "divider" },
    { "type": "button", "action": "diagnose", "label": "检查接收端与网络" },
    { "type": "button", "action": "install_bonjour", "label": "安装 / 修复 Bonjour 组件" }
  ]
}
